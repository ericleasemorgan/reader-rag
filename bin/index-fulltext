#!/usr/bin/env bash

# index.sh - full text index everything

# Eric Lease Morgan <eric_morgan@infomotions.com>
# (c) Infomotions, LLC; distributed under a GNU Public License

# June     29, 2025 - first cut
# November 22, 2026 - added check for semantic indexing


# initialize
LIBRARY=$( rdr get )
CARRELS=$( rdr catalog )

tabs 26

# process each carrel
for CARREL in ${CARRELS[@]}; do

	printf "$CARREL\t"

	# get the most significant keywords
	KEYWORDS=$( rdr wrd $CARREL -c | head -n 2 | cut -f1 )

	RESULT=$( rrag match $CARREL -q "$KEYWORDS" 2>/dev/null )
	if [[ ${#RESULT} > 1 ]]; then
		printf 'INDEXED\t' >&2; 
	else
		./indexer/index.sh $CARREL fulltext
	fi
		
	echo
	
# fini
done
exit