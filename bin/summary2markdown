#!/usr/bin/env bash

# summary2markdown.sh - use RAG to generate and save a summaries of carrels in teh form of markdown

# Eric Lease Morgan <eric_morgan@infomotions.com>
# (c) Infomotions, LLC; distributed under a GNU Public License

# November 27, 2026 - first cut; after getting a membership to TCF


# configure
LIBRARY=$( rdr get )
CARRELS=$( rdr catalog )
INDEX='./index.md'
EPILOGUE="\n\n---\n\nThis description was generated by first searching the carrel's sentences for the given keywords, and second, summarizing the result.\n\n"
SIGNATURE="Eric Lease Morgan  TODAY"

# process each carrel
for CARREL in ${CARRELS[@]}; do

	# debug
	#echo -e "\t$CARREL" >&2
	
	# make sane
	cd $LIBRARY/$CARREL
	
	# don't do the work again
	if [[ ! -f $INDEX ]]; then
	
		# re-initialize
		KEYWORDS=$( rdr wrd $CARREL -c | head -n 2 | cut -f1 )
		QUERY=$( echo $KEYWORDS | sed "s/ / AND /" )
		KEYWORDS=$( echo $QUERY | sed "s/ AND / and /" )
		
		# search
		rrag match $CARREL -q "$QUERY" > /dev/null
		
		# output introduction
		echo -e "\n# $CARREL\n\nThe most signficiant keywords in the carrel named *'$CARREL'* are $KEYWORDS, and it may be characterized as being about the following:\n" > $INDEX
		
		# do the work
		rrag elaborate 'In the form of markdown, summarize.' >> $INDEX
		
		# add epilogue and signature
		echo -e $EPILOGUE >> $INDEX
		echo -e $SIGNATURE >> $INDEX
		
		# view result
		cat $INDEX | glow
	
	else
	
		# view result
		cat $INDEX | glow
	
	fi

		# delimit
		echo -e "\n\n------------------------\n\n" >&2	
	
# done
done
exit