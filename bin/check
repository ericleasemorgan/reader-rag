#!/usr/bin/env bash

# check.sh - make sure things are indexed

# Eric Lease Morgan <eric_morgan@infomotions.com>
# (c) Infomotions, LLC; distributed under a GNU Public License

# June     29, 2025 - first cut
# November 22, 2026 - added check for semantic indexing


# configure
QUERY='love'

# initialize
LIBRARY=$( rdr get )
CARRELS=$( rdr catalog )

tabs 26

echo -e "Carrel\tFulltext\tSemantics"

# process each carrel
for CARREL in ${CARRELS[@]}; do

	printf "$CARREL\t"

	# get the most significant keywords
	KEYWORDS=$( rdr wrd $CARREL -c | head -n 2 | cut -f1 )

	RESULT=$( rrag match $CARREL -q "$KEYWORDS" 2>/dev/null )
	if [[ ${#RESULT} > 1 ]]; then
		printf 'INDEXED\t' >&2; 
	else
		printf 'NOT INDEXED\t' >&2; 
	fi
	
	RESULT=$( rrag search $CARREL -q "$KEYWORDS" 2>/dev/null )
	if [[ ${#RESULT} > 1 ]]; then
		printf 'INDEXED' >&2; 
	else
		printf 'NOT INDEXED' >&2; 
	fi
	
	echo
	
# fini
done
exit