#!/usr/bin/env bash

# search - given a carrel and a few query words, search the carrel

# Eric Lease Morgan <eric_morgan@infomotions.com>
# (c) Infomotions, LLC; distributed under a GNU Public License

# November 21, 2026 - first cut
# November 26, 2026 - tweaking with new search function


if [[ -z $1 || -z $2 || -z $3 ]]; then
	echo "Usage: $0 <type> <carrel> <query>" >&2
	exit
fi
TYPE=$1
CARREL=$2
QUERY=$3

# parse out the first word for display
WORD=$(echo "$QUERY" | cut -d' ' -f1)

# search, reformat, and display
rrag $TYPE $CARREL -q "$QUERY" >/dev/null && rrag reformat | fmt | less -i --pattern="$WORD"

# done
exit
